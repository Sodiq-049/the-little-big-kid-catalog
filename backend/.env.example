# Copy this file to .env and fill in the values
PORT=4000
MONGODB_URI=mongodb://localhost:27017/little-big-kid

# Password for hello@thelittlebigkid.net (the only admin login)
ADMIN_PASSWORD=

# Long random string used to sign admin login tokens, e.g. output of: openssl rand -hex 32
JWT_SECRET=

# Frontend URL(s) allowed to call the API, comma-separated. Leave empty to allow all.
CORS_ORIGIN=http://localhost:3000
